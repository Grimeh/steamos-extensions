#!/bin/bash
set -e

TargetSwapFileSizeInGbs=20
HibernateDelaySec="60min"
HibernateOnACPower="no"

function load_config {
	local config_file="/var/lib/steamos-extensions-config/hibernate-after-sleep"
	if [[ -f "$config_file" ]]; then
		local value=$(grep -E '^HibernateDelaySec=' "$config_file" | head -1 | cut -d= -f2 | tr -d '"' | grep -oE '^[0-9]+[a-z]+( [0-9]+[a-z]+)*$')
		if [[ -n "$value" ]]; then
			HibernateDelaySec="$value"
		fi

		value=$(grep -E '^TargetSwapFileSizeInGbs=' "$config_file" | head -1 | cut -d= -f2 | tr -d '"' | grep -oE '^[0-9]+$')
		if [[ -n "$value" ]]; then
			TargetSwapFileSizeInGbs="$value"
		fi

		value=$(grep -E '^HibernateOnACPower=' "$config_file" | head -1 | cut -d= -f2 | tr -d '"')
		case "$value" in
			yes|true)  HibernateOnACPower="yes" ;;
			no|false)  HibernateOnACPower="no" ;;
		esac
	fi
}

function is_btrfs {
	local fstype=$(findmnt -no FSTYPE -T /home)
	[[ "$fstype" == "btrfs" ]]
}

function get_swapfile_path {
	if is_btrfs; then
		echo "/home/@swapfile/swapfile"
	else
		echo "/home/swapfile"
	fi
}

function check_swap_space_available {
	local swapfile_path=$(get_swapfile_path)
	local swapfile_dir=$(dirname "$swapfile_path")
	local required_gb=$TargetSwapFileSizeInGbs

	# Get available space in KB and convert to GB
	local available_kb=$(df --output=avail "$swapfile_dir" | tail -1)
	local available_gb=$((available_kb / 1024 / 1024))

	# Get existing swap file size if it exists
	local existing_swap_gb=0
	if [[ -f "$swapfile_path" ]]; then
		local existing_bytes=$(stat -c %s "$swapfile_path" 2>/dev/null || echo 0)
		existing_swap_gb=$((existing_bytes / 1024 / 1024 / 1024))
	fi

	# Total space = available + space that will be freed from existing swap
	local total_available_gb=$((available_gb + existing_swap_gb))

	if [[ $total_available_gb -lt $required_gb ]]; then
		echo "Error: Insufficient disk space for ${required_gb}GB swap file." >&2
		echo "  Available: ${available_gb}GB" >&2
		if [[ $existing_swap_gb -gt 0 ]]; then
			echo "  Existing swap: ${existing_swap_gb}GB (will be freed)" >&2
			echo "  Total available: ${total_available_gb}GB" >&2
		fi
		echo "  Required: ${required_gb}GB" >&2
		echo "  Additional space needed: $((required_gb - total_available_gb))GB" >&2
		return 1
	fi

	return 0
}

function setup_swapfile_btrfs {
	local swapfile_path="/home/@swapfile/swapfile"
	local target_size="${TargetSwapFileSizeInGbs}G"

	if [[ ! -d "/home/@swapfile" ]]; then
		btrfs subvolume create /home/@swapfile
	fi

	local needs_rebuild=0
	if [[ ! -f "$swapfile_path" ]]; then
		needs_rebuild=1
	else
		local target_bytes=$(($TargetSwapFileSizeInGbs*1073741824))
		local current_size=$(stat -c %s "$swapfile_path" 2>/dev/null || echo 0)
		if [[ $current_size != $target_bytes ]]; then
			needs_rebuild=1
		fi
	fi

	if [[ $needs_rebuild -eq 1 ]]; then
		echo "Configuring swapfile on BTRFS"
		swapoff "$swapfile_path" 2>/dev/null || true
		rm -f "$swapfile_path"
		truncate -s 0 "$swapfile_path"
		chattr +C "$swapfile_path"
		fallocate -l "$target_size" "$swapfile_path"
		chmod 600 "$swapfile_path"
		mkswap "$swapfile_path"
		swapon "$swapfile_path"
	fi
}

function setup_swapfile_ext4 {
	local swapfile_path="/home/swapfile"
	local target_bytes=$(($TargetSwapFileSizeInGbs*1073741824))
	local current_size=$(stat -c %s "$swapfile_path" 2>/dev/null || echo 0)

	if [[ $current_size != $target_bytes ]]; then
		echo "Configuring swapfile"
		swapoff -a 2>/dev/null || true
		dd if=/dev/zero of="$swapfile_path" bs=1G count=$TargetSwapFileSizeInGbs
		chmod 600 "$swapfile_path"
		mkswap "$swapfile_path"
		swapon "$swapfile_path"
		e4defrag "$swapfile_path" 2>/dev/null || true
	fi
}

function setup_swapfile {
	if is_btrfs; then
		setup_swapfile_btrfs
	else
		setup_swapfile_ext4
	fi
}

function get_swap_offset {
	local swapfile_path=$(get_swapfile_path)

	if is_btrfs; then
		btrfs inspect-internal map-swapfile -r "$swapfile_path"
	else
		filefrag -v "$swapfile_path" | awk '$1=="0:" {print substr($4, 1, length($4)-2)}'
	fi
}

function update_grub_resume {
	local swapfile_path=$(get_swapfile_path)
	local uuid=$(findmnt -no UUID -T "$swapfile_path")
	local offset=$(get_swap_offset)
	local starter=steamenv_boot
	local cfg=/boot/efi/EFI/steamos/grub.cfg
	local remount=false

	# HoloISO
	if [[ -f /boot/grub/grub.cfg ]]; then
		starter=linux
		cfg=/boot/grub/grub.cfg
		remount=true
	fi

	if [[ ! -e $cfg ]]; then
		echo "Warning: GRUB config file not found at $cfg"
		return 1
	fi

	# Check if resume parameters are already set correctly
	if grep -q "resume=/dev/disk/by-uuid/$uuid" "$cfg" && grep -q "resume_offset=$offset" "$cfg"; then
		echo "GRUB resume parameters already configured correctly"
		return 0
	fi

	# HoloISO keeps boot on the readonly partition.
	if $remount && [[ ! -f /tmp/.hibernate-after-sleep-readonly-disabled ]]; then
		steamos-readonly disable
		touch /tmp/.hibernate-after-sleep-readonly-disabled
	fi

	echo "Updating GRUB configuration"

	# Remove existing resume parameters if present
	sed -i -E 's/ resume=[^ ]*//g' "$cfg"
	sed -i -E 's/ resume_offset=[0-9]*//g' "$cfg"
	sed -i -E 's/ rtc_cmos.use_acpi_alarm=1//g' "$cfg"

	# Add new resume parameters
	sed -i -E 's@^(\s*)'$starter'(.*)$@\1'$starter'\2 resume=/dev/disk/by-uuid/'$uuid' resume_offset='$offset' rtc_cmos.use_acpi_alarm=1@g' "$cfg"
	touch /tmp/.hibernate-after-sleep-modified
}

function ensure_swapfile_homedir_fix {
	# This is an improved fix for the issue where systemd-logind cannot access
	# files under /home which causes the swap space check to fail when it
	# shouldn't. See details here:
	# https://wiki.archlinux.org/title/Power_management/Suspend_and_hibernate#No_such_file_or_directory

	# NOTE: This file is already present in steamOS as of 3.7.21
	# (possibly earlier) and thus this fix most likely isn't actually
	# required any longer. Leaving it here just in case.

	# UPDATE: In more recent versions (checked 3.9.0 23rd April img) this file
	# ALSO contains the bypass env var fix to skip the memory check altogether.
	# The readonly home dir fix should be all that's required for the swap
	# space check to work correctly. Possibly exploring removing the readonly
	# home dir setting due to security concerns? Unless there are more issues
	# beyond the home dir swap space check.
	# So far my device has not had any issues hibernating with only the
	# readonly home dir fix, but it hasn't been long enough to say for sure.

	local override_dir="/etc/systemd/system/systemd-logind.service.d"
	local override_file="$override_dir/homedir-override.conf"
	local protect_home="ProtectHome=read-only"
	local needs_reload=0

	mkdir -p "$override_dir"

	if [[ ! -f "$override_file" ]]; then
		echo "[Service]" > "$override_file"
		echo "$protect_home" >> "$override_file"
		chmod 644 $override_file
		needs_reload=1
	else
		if grep -q "^$protect_home" "$override_file"; then
			return 0
		fi

		local in_service_section=0
		local temp_file=$(mktemp)

		while IFS= read -r line; do
			if [[ "$line" =~ ^\[Service\] ]]; then
				in_service_section=1
				echo "$line" >> "$temp_file"
			elif [[ "$line" =~ ^\[.*\] ]]; then
				if [[ $in_service_section -eq 1 ]]; then
					echo "$protect_home" >> "$temp_file"
					in_service_section=0
					needs_reload=1
				fi
				echo "$line" >> "$temp_file"
			else
				echo "$line" >> "$temp_file"
			fi
		done < "$override_file"

		if [[ $in_service_section -eq 1 ]]; then
			echo "$protect_home" >> "$temp_file"
			needs_reload=1
		fi

		if [[ $needs_reload -eq 0 ]]; then
			echo "" >> "$temp_file"
			echo "[Service]" >> "$temp_file"
			echo "$protect_home" >> "$temp_file"
			needs_reload=1
		fi

		mv "$temp_file" "$override_file"
		chmod 644 $override_file
	fi

	if [[ $needs_reload -eq 1 ]]; then
		echo "Configuring systemd-logind swapfile homedir fix"
		systemctl daemon-reload
	fi
}

function enable_suspend_hibernate {
	local suspend_service="/etc/systemd/system/systemd-suspend.service"
	local target_service="/usr/lib/systemd/system/systemd-suspend-then-hibernate.service"

	if [[ ! -f "$suspend_service" ]]; then
		echo "Enabling suspend-then-hibernate"
		ln -s "$target_service" "$suspend_service"
		systemctl daemon-reload
	fi
}

function update_sleep_config {
	# Write to /etc/systemd/sleep.conf.d/ so it takes precedence over
	# /usr/lib/systemd/sleep.conf.d/ drop-ins (e.g. SteamOS 3.8 disables
	# hibernation there with "Disabled for 3.8.x cycle").
	# /etc/ drop-ins always win over /usr/lib/ drop-ins regardless of filename.
	local dropin_dir="/etc/systemd/sleep.conf.d"
	local dropin_file="$dropin_dir/hibernate-after-sleep.conf"
	mkdir -p "$dropin_dir"
	echo "[Sleep]
AllowSuspend=yes
AllowHibernation=yes
AllowSuspendThenHibernate=yes
HibernateDelaySec=$HibernateDelaySec
HibernateOnACPower=$HibernateOnACPower" > "$dropin_file"
	echo "Configured hibernate delay: $HibernateDelaySec"
}

function enable_resume_services {
	systemctl enable steamos-extension-hibernate-after-sleep-fix-bluetooth.service 2>/dev/null || true
	systemctl enable steamos-extension-hibernate-after-sleep-mark-boot-good.service 2>/dev/null || true
}

function cleanup {
	if [[ -f /tmp/.hibernate-after-sleep-readonly-disabled ]]; then
		rm -f /tmp/.hibernate-after-sleep-readonly-disabled
		steamos-readonly enable
	fi

	if [[ -f /tmp/.hibernate-after-sleep-modified ]]; then
		rm -f /tmp/.hibernate-after-sleep-modified
		echo "GRUB configuration updated. Please reboot for changes to take effect."
	fi
}

load_config

# Validate disk space before attempting to setup swap
if ! check_swap_space_available; then
	exit 1
fi

setup_swapfile
update_grub_resume
ensure_swapfile_homedir_fix
enable_suspend_hibernate
update_sleep_config
enable_resume_services
cleanup
